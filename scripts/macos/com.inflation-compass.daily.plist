<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.inflation-compass.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/scripts/macos/run_daily.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/daily_job.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/daily_job_error.log</string>
</dict>
</plist>
